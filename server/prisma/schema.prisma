generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CORE ────────────────────────────────────────────────────────────────────

model Hotel {
  id                 String   @id @default(cuid())
  name               String   @default("Quantum Vorvex")
  ownerName          String   @default("Admin")
  phone              String?
  email              String?
  gstin              String?
  licenseNo          String?
  address            String?
  logoUrl            String?
  gstRate            Float    @default(12)
  gstType            String   @default("CGST+SGST")
  gstApplyOn         String   @default("All")
  lateFeeRate        Float    @default(5)
  gracePeriod        Int      @default(3)
  setupComplete      Boolean  @default(false)
  termsAndConditions String?
  wifiPassword       String?
  // JSON-encoded config blobs for Settings tabs that have no dedicated table.
  documentsConfig    String?   // { kycDocs:[{id,label,required,maxMB,enabled}], expiryReminderDays }
  branding           String?   // { tagline, loginTitle, footerNote, logoUrl }
  preferences        String?   // { language, currency, dateFormat, timeFormat, itemsPerPage, soundAlerts, emailDigest, autoLogout }
  appearance         String?   // { accent, density, radius }
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Property {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  gstin     String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  rooms     Room[]
}

model RoomType {
  id              String @id @default(cuid())
  name            String @unique
  dailyRate       Float  @default(500)
  monthlyRate     Float  @default(10000)
  peakDailyRate   Float  @default(700)
  peakMonthlyRate Float  @default(14000)
  maxOccupancy    Int    @default(2)
  rooms           Room[]
}

model Room {
  id                 String              @id @default(cuid())
  number             String              @unique
  qrToken            String?             @unique
  typeId             String
  type               RoomType            @relation(fields: [typeId], references: [id])
  floor              Int                 @default(1)
  status             String              @default("available")
  dailyRate          Float               @default(500)
  monthlyRate        Float               @default(10000)
  propertyId         String?
  property           Property?           @relation(fields: [propertyId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  guests             Guest[]
  bookings           Booking[]
  maintenanceRequests MaintenanceRequest[]
  housekeepingStatus HousekeepingStatus?
}

model Guest {
  id              String     @id @default(cuid())
  docId           String     @unique
  name            String
  phone           String
  email           String?
  gender          String?
  dob             DateTime?
  nationality     String?
  idType          String
  idNumber        String
  tags            String     @default("[]")
  notes           String?
  address         String?
  emergencyName   String?
  emergencyPhone  String?
  stayType        String     @default("daily")
  roomId          String
  room            Room       @relation(fields: [roomId], references: [id])
  checkInDate     DateTime
  checkOutDate    DateTime?
  months          Int?
  roomRate        Float
  deposit         Float?
  occupants       Int        @default(1)
  specialRequests String?
  status          String     @default("Active")
  foodPlan        String?
  stayCount       Int        @default(1)
  amenities       String     @default("[]")
  facilities      String     @default("[]")
  source          String     @default("walk_in")
  whatsappOptIn   Boolean    @default(true)
  selfCheckedIn   Boolean    @default(false)
  signature       String?
  propertyId      String?
  documents       Document[]
  invoices        Invoice[]
  payments        Payment[]
  reminders       Reminder[]
  bookings        Booking[]
  communications  GuestCommunication[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Document {
  id         String   @id @default(cuid())
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  docType    String
  url        String
  verified   Boolean  @default(false)
  uploadedAt DateTime @default(now())
}

model Invoice {
  id          String    @id @default(cuid())
  invoiceNo   String    @unique
  guestId     String
  guest       Guest     @relation(fields: [guestId], references: [id])
  period      String
  rent        Float
  food        Float     @default(0)
  amenities   Float     @default(0)
  gstRate     Float
  gstAmount   Float
  total       Float
  amountPaid  Float     @default(0)
  hsnCode     String?
  gstSlab     Float?
  status      String    @default("Pending")
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  payments    Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id])
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  amount    Float
  method    String   @default("cash")
  reference String?
  type      String   @default("collection")
  createdAt DateTime @default(now())
}

model Booking {
  id                  String    @id @default(cuid())
  bookingNo           String    @unique

  // ── Guest details (inline) + optional link to a Guest record ──
  guestName           String
  guestPhone          String?
  guestEmail          String?
  guestAddress        String?
  nationality         String?
  idType              String?
  idNumber            String?
  adults              Int       @default(1)
  children            Int       @default(0)
  guestId             String?
  guest               Guest?    @relation(fields: [guestId], references: [id])

  // ── Room + stay ──
  roomId              String
  room                Room      @relation(fields: [roomId], references: [id])
  stayType            String    @default("daily")     // daily | monthly
  fromDate            DateTime
  toDate              DateTime?
  months              Int?
  nights              Int?

  // ── Pricing breakdown ──
  roomRate            Float     @default(0)
  subtotal            Float     @default(0)
  discount            Float     @default(0)
  taxRate             Float     @default(0)
  taxAmount           Float     @default(0)
  extraCharges        Float     @default(0)
  amount              Float                            // grand total
  advance             Float     @default(0)
  balance             Float     @default(0)
  paymentStatus       String    @default("unpaid")     // unpaid | partial | paid

  // ── Meta + lifecycle ──
  notes               String?
  specialRequests     String?
  source              String    @default("walk_in")    // walk_in | phone | website | ota | referral | corporate
  status              String    @default("Pending")    // Pending | Confirmed | CheckedIn | CheckedOut | Cancelled | NoShow
  confirmedAt         DateTime?
  checkedInAt         DateTime?
  checkedOutAt        DateTime?
  cancelledAt         DateTime?
  cancelReason        String?

  selfCheckinToken    String?
  selfCheckinComplete Boolean   @default(false)
  propertyId          String?
  documents           BookingDocument[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ID / KYC documents captured at booking time (Aadhaar front/back, PAN, etc.)
model BookingDocument {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  docType    String
  url        String
  verified   Boolean  @default(false)
  uploadedAt DateTime @default(now())

  @@index([bookingId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   @default("info")
  message   String
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  // Legacy string role — kept during the RBAC migration for a safe cutover.
  // New source of truth is `roleId` → Role. Dropped in the final cleanup phase.
  role           String   @default("staff")
  roleId         String?
  roleRef        Role?    @relation(fields: [roleId], references: [id])
  status         String   @default("active")
  phone          String?
  // Set when an account is created/reset with the shared default password.
  // Wired but not yet enforced (password change is optional for now).
  mustChangePassword Boolean @default(false)
  sessionVersion Int      @default(0)   // bumped on every login (and on role/password change) → stale tokens rejected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([roleId])
}

// ─── RBAC: admin-defined roles + per-module access levels ───────────────────────
// Module keys = the backend route domains (validated against server/src/config/modules.js):
//   bookings, maintenance, guests, rooms, documents, food, housekeeping,
//   billing, reports, settings, users
// (today / cancellations are UI-only panels, derived in the frontend.)
enum AccessLevel {
  NONE
  VIEW
  MANAGE
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)  // seeded roles: protected from deletion
  isOwner     Boolean          @default(false)  // implicit full access — bypasses permission checks
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id     String      @id @default(cuid())
  roleId String
  role   Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module String                          // one of the module keys (validated in code)
  level  AccessLevel @default(NONE)

  @@unique([roleId, module])
  @@index([roleId])
}

// ─── AUTH: password reset + passwordless OTP login ──────────────────────────────
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String                       // sha256 of the raw token (raw value only ever sent in email)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginOtp {
  id        String    @id @default(cuid())
  email     String
  codeHash  String                       // sha256 of the 6-digit code
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model FoodPlan {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  oneTimeRate Float   @default(0)
  weeklyRate  Float   @default(0)
  monthlyRate Float   @default(0)
  active      Boolean @default(true)
}

model Amenity {
  id          String  @id @default(cuid())
  name        String  @unique
  dailyRate   Float   @default(0)
  monthlyRate Float   @default(0)
  chargeable  Boolean @default(true)
}

// ─── ADDON 1: SMART PRICING ───────────────────────────────────────────────────

model PricingRule {
  id          String  @id @default(cuid())
  name        String
  triggerType String
  threshold   Float
  adjustment  Float
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
}

model CompetitorRate {
  id           String   @id @default(cuid())
  name         String
  roomType     String
  theirRate    Float
  recordedDate DateTime @default(now())
}

// ─── ADDON 2: WHATSAPP / MESSAGING ───────────────────────────────────────────

model Reminder {
  id         String    @id @default(cuid())
  guestId    String
  guest      Guest     @relation(fields: [guestId], references: [id])
  channel    String
  message    String
  status     String    @default("pending")
  sentAt     DateTime?
  providerId String?
  createdAt  DateTime  @default(now())
}

model MessageTemplate {
  id      String  @id @default(cuid())
  trigger String  @unique
  content String
  active  Boolean @default(true)
}

// ─── ADDON 3: MAINTENANCE ─────────────────────────────────────────────────────

model MaintenanceRequest {
  id          String            @id @default(cuid())
  ticketNo    String            @unique
  roomId      String
  room        Room              @relation(fields: [roomId], references: [id])
  category    String            @default("Other")   // Plumbing | Electrical | HVAC | Furniture | Housekeeping | Other
  title       String
  issueType   String?                                // legacy alias for category
  description String?
  priority    String            @default("Medium")   // Low | Medium | High | Urgent
  reportedBy  String            @default("Front Desk")
  assignedTo  String?
  status      String            @default("Open")     // Open | In Progress | Resolved
  photoUrl    String?
  notes       MaintenanceNote[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?
}

model MaintenanceNote {
  id        String             @id @default(cuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id])
  author    String
  content   String
  createdAt DateTime           @default(now())
}

model MaintenanceSchedule {
  id         String    @id @default(cuid())
  roomType   String
  task       String
  frequency  String
  assignedTo String?
  lastDone   DateTime?
  nextDue    DateTime
}

// ─── ADDON 4: STAFF ───────────────────────────────────────────────────────────
// Removed 2026-06-14: the Staff / StaffSession / StaffProperty / ActivityLog /
// Permission models were dead (all tables empty, accounts could not log in).
// Identity is unified on User + Role (see above). A clean AuditLog (FK → User)
// will be (re)introduced with backend enforcement.

// ─── ADDON 9: HOUSEKEEPING ────────────────────────────────────────────────────

model HousekeepingStatus {
  id          String    @id @default(cuid())
  roomId      String    @unique
  room        Room      @relation(fields: [roomId], references: [id])
  status      String    @default("clean_available")
  assignedTo  String?
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model LinenRecord {
  id          String   @id @default(cuid())
  roomId      String
  lastChanged DateTime
  nextDue     DateTime
  changedBy   String
}

model RoomInspection {
  id        String   @id @default(cuid())
  roomId    String
  staffId   String
  checklist String   @default("[]")
  createdAt DateTime @default(now())
}

// ─── ADDON 15: GUEST PORTAL ───────────────────────────────────────────────────

model GuestPortalToken {
  id        String   @id @default(cuid())
  bookingId String?
  token     String   @unique
  type      String   @default("booking")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── ADDON 16: GUEST COMMUNICATIONS LOG ───────────────────────────────────────

model GuestCommunication {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel   String   @default("note")    // whatsapp | sms | email | call | note
  direction String   @default("outbound") // inbound | outbound
  subject   String?
  content   String
  staff     String?                        // who logged / sent it
  createdAt DateTime @default(now())
}
