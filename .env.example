# =============================================================================
# Quantum Vorvex — Docker Compose environment
# Copy to .env and fill in REAL values.  NEVER commit .env to git.
#   cp .env.example .env
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=quantumvorvex
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=quantumvorvex
# (DATABASE_URL is assembled from the three values above inside docker-compose.yml)

# ── App ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_generate_a_32_char_random_secret
# Public site URL(s) for CORS — comma-separated, no trailing slash
CLIENT_URL=https://hotel.example.com
# One active session per user (logging in elsewhere evicts the old session)
ENFORCE_SINGLE_SESSION=true

# ── Email (password-reset links + login OTP codes) ───────────────────────────
# Gmail SMTP via a 16-char App Password. Leave blank to print codes to the logs.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=Quantum Vorvex <youraddress@gmail.com>
